# ── AI Provider ──────────────────────────────────────────────────
# Which AI backend to use: "groq" (default), "ollama", or "gemini"
AI_PROVIDER=

# ── Groq (hosted LLMs via Vercel AI SDK) ────────────────────────
# Only needed when AI_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides (defaults to llama-3.3-70b-versatile)
# GROQ_MAIN_MODEL=llama-3.3-70b-versatile
# GROQ_SCHEMA_MODEL=llama-3.3-70b-versatile
# GROQ_MISC_MODEL=llama-3.3-70b-versatile
# Optional custom API endpoint
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Ollama (local LLMs) ─────────────────────────────────────────
# Only needed when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ── Google Gemini ────────────────────────────────────────────────
# Only needed when AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/schema_ai

# ── Session Secret (optional for development) ────────────────────
# Better Auth / Google OAuth (active login provider)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional client-side base URL (same-origin apps can omit this)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (required for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Notion OAuth (optional for future Notion integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

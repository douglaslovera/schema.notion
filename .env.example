# ── OpenRouter ───────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── PostgreSQL Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/schema_ai
# Tune these values to match your database or external connection pool.
DATABASE_MAX_CONNECTIONS=5
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_MAX_LIFETIME_SECONDS=1800

# ── Session Secret (optional for development) ───────────────────
# Better Auth / Google OAuth (active login provider)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional client-side base URL.
# When testing through cloudflared on another device, use the tunnel origin
# instead of localhost, or omit this for same-origin client requests.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (required for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
